{
  "name": "actions-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "verify:schema": "tsx scripts/verify-schema.ts",
    "verify:setup": "tsx scripts/verify-setup.ts",
    "generate:arbiter": "tsx scripts/generate-arbiter-keypair.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.3",
    "@supabase/supabase-js": "^2.49.1",
    "body-parser": "^1.20.2",
    "bs58": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "multer": "^2.1.0",
    "nodemailer": "^8.0.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^7.2.0",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.2"
  }
}
