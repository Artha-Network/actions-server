# Actions Server Environment Variables
# Copy to .env and fill in values

# Required. Supabase Postgres connection string (Transaction Pooler URL)
DATABASE_URL=

# Required. Supabase project URL
SUPABASE_URL=

# Required. Supabase service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE=

# Required. Solana cluster ('devnet' or 'mainnet-beta')
SOLANA_CLUSTER=devnet

# Optional. Custom Solana RPC endpoint (defaults to public cluster API)
SOLANA_RPC_URL=

# Optional. Comma-separated RPC endpoints for failover
RPC_ENDPOINTS=

# Required. Anchor program ID (must match deployed program)
PROGRAM_ID=B1a1oejNg8uWz7USuuFSqmRQRUSZ95kk2e4PzRZ7Uti4

# Required. USDC mint address (devnet default shown)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Required. Arbiter service Ed25519 public key (hex) for verifying resolve tickets
ARBITER_ED25519_PUBLIC_HEX=

# Optional. Arbiter service URL (for forwarding arbitration requests)
ARBITER_SERVICE_URL=http://localhost:3001

# Optional. CORS origins (comma-separated). Empty = same-origin only
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional. Gmail SMTP for email notifications
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional. Anthropic API key for AI-generated email content
ANTHROPIC_API_KEY=

# Optional. Frontend URL for email links (default: https://artha.network)
FRONTEND_URL=http://localhost:5173

# Optional. Enable sponsored transaction fees
FEATURE_SPONSORED_FEES=false
FEE_PAYER_PUBKEY=

# Optional. Port (default: 4000)
PORT=4000

# Optional. Node environment
NODE_ENV=development
